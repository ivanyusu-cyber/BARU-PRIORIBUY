# PrioriBuy — pengaturan dasar (Apache / InfinityFree)
Options -Indexes
DirectoryIndex index.html index.php

# Nama halaman lama di spesifikasi (.html) -> file PHP yang sebenarnya
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^pembayaran\.html$ pembayaran.php [L,R=301]
    RewriteRule ^konfirmasi\.html$ konfirmasi.php [L,R=301]

    # (Opsional) Paksa HTTPS — aktifkan HANYA setelah SSL di InfinityFree aktif.
    # RewriteCond %{HTTPS} off
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Jangan sajikan file internal
<FilesMatch "\.(sql|md|gs|log|bak|ini|inc)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
